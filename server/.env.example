# Copy this file to server/.env and fill in the values

# Neon Postgres connection string (Neon dashboard → Connect)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Any long random string; used to sign admin login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Razorpay (dashboard.razorpay.com → Settings → API Keys). Use test keys while developing.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Email for purchase receipts (any SMTP provider). Gmail example:
#   SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#   SMTP_PASS=<16-character Google "App password", not your normal password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional "From" shown to students; defaults to SkillifyMe <SMTP_USER>
# MAIL_FROM=SkillifyMe <no-reply@skillifyme.co.in>

# How long public data (courses, reviews, ...) is kept in memory, in seconds (0 = off). Default 60.
# PUBLIC_CACHE_SECONDS=60
# Set to 1 to stop Neon's free database from sleeping (faster first visit, uses more free compute hours)
# KEEP_DB_WARM=1

# Set to 1 when hosted behind a proxy (Render, Railway, ...) so rate limits see real visitor IPs
# TRUST_PROXY=1

# Optional: website address(es) allowed to call the API, comma-separated
# CORS_ORIGIN=https://skillifyme.co.in
