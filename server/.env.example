# Copy this file to server/.env and fill in the values

# Neon Postgres connection string (Neon dashboard → Connect)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Any long random string; used to sign admin login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Razorpay (dashboard.razorpay.com → Settings → API Keys). Use test keys while developing.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Optional: website address(es) allowed to call the API, comma-separated
# CORS_ORIGIN=https://skillifyme.co.in
